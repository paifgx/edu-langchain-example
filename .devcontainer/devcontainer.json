{
  "name": "LangChain Schulung (snippets)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "installOhMyZsh": false
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -U pip setuptools wheel && .venv/bin/python setup.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI / uvicorn",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}